# Environment Variables
# Copy this file to .env and fill in the values

# Database
DATABASE_URL=postgresql://testcolony:testcolony@localhost:5432/testcolony
REDIS_URL=redis://localhost:6379

# DeepSeek API (Primary LLM)
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_DEFAULT_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner

# Claude CLI (Optional, for CLI agent mode)
CLAUDE_CLI_PATH=claude
CLAUDE_CLI_MAX_CONCURRENT=5
CLAUDE_CLI_IDLE_TIMEOUT_MS=300000

# JWT
JWT_SECRET=change-this-to-a-random-secret
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads

# App
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
WS_URL=ws://localhost:4000
NODE_ENV=development

# Docker sandbox (for test execution)
DOCKER_SANDBOX_ENABLED=false
DOCKER_SANDBOX_IMAGE=testcolony-runner:latest
